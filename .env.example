# Contoh isi .env.local (tanpa nilai rahasia). Salin menjadi .env.local lalu isi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci tanda tangan cookie sesi login (rahasia, minimal 32 karakter, khusus server).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
